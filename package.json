{
  "name": "orbit-voice",
  "productName": "Orbit",
  "version": "1.3.0-beta.1",
  "description": "A hands-free voice companion for Claude Code Desktop, powered by Grok Voice. Hear what your sessions are doing and dictate prompts into them.",
  "type": "module",
  "private": true,
  "main": "electron/boot.mjs",
  "author": "Cookiebubba",
  "license": "MIT",
  "homepage": "https://github.com/Cookiebubba/orbit-voice",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cookiebubba/orbit-voice.git"
  },
  "scripts": {
    "app": "electron .",
    "web": "node src/server.js",
    "build:ui": "npm --prefix ui ci --no-audit --no-fund && npm --prefix ui run build",
    "icons": "electron scripts/make-icons.mjs",
    "icons:mac": "electron scripts/make-icons.mjs --mac",
    "check": "node src/selftest.js",
    "dist": "npm run build:ui && node scripts/fetch-model.mjs && electron-builder --win --publish never",
    "dist:mac": "npm run build:ui && node scripts/fetch-model.mjs && node scripts/mac-native.mjs && electron-builder --mac --publish never",
    "mac:native": "node scripts/mac-native.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "test": "node --test test/*.test.js && node --import ./test/fuzz/register.mjs --test test/sandboxed/*.test.js",
    "fuzz": "node --import ./test/fuzz/register.mjs test/fuzz/fuzz.mjs",
    "parity": "node parity/run.mjs",
    "parity:audio": "node parity/fetch-voice-models.mjs && node parity/gen-audio.mjs",
    "test:native": "node --test parity/test/match.test.mjs mac-swift/sidecar/sidecar.test.mjs",
    "native:app": "bash mac-swift/scripts/build-app.sh",
    "e2e:wake": "electron scripts/wake-audio-e2e.mjs",
    "e2e:avatar": "electron scripts/avatar-e2e.mjs",
    "e2e:avatar-free": "electron scripts/avatar-free-e2e.mjs",
    "e2e:audio": "electron scripts/audio-e2e.mjs",
    "e2e:anywhere": "electron scripts/anywhere-e2e.mjs",
    "e2e:mouse": "electron scripts/mouse-e2e.mjs",
    "fuzz:e2e": "electron scripts/fuzz-e2e.mjs",
    "latency:claude-voice": "node scripts/claude-voice-latency.mjs",
    "eval:intent": "node scripts/intent-eval.mjs",
    "eval:listen": "node scripts/listen-eval.mjs",
    "eval:emote": "node scripts/emote-eval.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.orbit.voice",
    "productName": "Orbit",
    "copyright": "Copyright © 2026 Orbit contributors",
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!src/selftest.js",
      "!electron/selftest.js"
    ],
    "asarUnpack": [
      "src/desktop.ps1",
      "electron/claude-window.ps1",
      "src/platform/win/*.ps1",
      "src/platform/win/*.cs",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "node_modules/sherpa-onnx-darwin-arm64/**",
      "node_modules/sherpa-onnx-darwin-x64/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Orbit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Orbit-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Orbit listens so you can talk to Grok or Claude, and for the offline “Hey Orbit” wake word. Your voice goes only to the voice you chose, and only while a conversation is on.",
        "NSAppleEventsUsageDescription": "Orbit will use this to type your prompts into the Claude app and press Send for you (coming in a later version of Orbit for Mac).",
        "NSAccessibilityUsageDescription": "Orbit will use Accessibility to read and drive the Claude app window (coming in a later version of Orbit for Mac)."
      }
    },
    "dmg": {
      "artifactName": "Orbit-${version}-${arch}.${ext}",
      "title": "Orbit ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cookiebubba",
        "repo": "orbit-voice",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "*.tar.gz"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
