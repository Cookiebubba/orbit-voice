# Copy this file to .env and fill in your key.
# Get one at https://console.x.ai  (API Keys)
XAI_API_KEY=

# Optional settings
PORT=4317
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE=eve
# After sending a prompt, switch focus back to the window you were in (true/false)
RETURN_FOCUS=true

# Global start / sleep / wake hotkey
WAKE_HOTKEY=Control+Alt+G
GROK_VOICE_SPEED=1
