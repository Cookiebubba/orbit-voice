{
 "area": "voice",
 "about": "Spoken scenarios end to end: a clip (parity/voice-clips.json, made by parity/gen-audio.mjs) goes into each app's own microphone path (the fake microphone), through the bridge's on-device speech to text, to a scripted Claude Code (parity/fixtures/fake-claude.mjs), whose tool calls Orbit runs and gates as always against the stand-in desktop driver; Orbit's spoken reply is made on this Mac and played by each app (muted). Checked: the tool calls, their effect on the stand-in, consent, and that a reply was spoken.",
 "cases": [
  {
   "id": "voice.call.connects",
   "title": "The hotkey starts a call: connecting, then listening, with Claude voice ready",
   "needs": [
    "voice"
   ],
   "fixtures": {
    "claudeVoice": {
     "rules": {
      "rules": []
     }
    },
    "fakeDesktop": true
   },
   "steps": [
    {
     "do": "act",
     "action": "voice.hotkey"
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 25000,
     "expect": {
      "voice.phase": "listening",
      "voice.connected": true
     }
    },
    {
     "do": "state",
     "expect": {
      "events": {
       "$some": {
        "type": "voice.phase",
        "data.phase": "listening"
       }
      }
     }
    }
   ]
  },
  {
   "id": "voice.draft",
   "title": "Asking for work drafts a prompt into Claude's box (not sent) and Orbit asks to send it",
   "needs": [
    "voice"
   ],
   "fixtures": {
    "fakeDesktop": {
     "windows": [
      {
       "hwnd": 101,
       "kind": "main",
       "title": "Fix the login bug",
       "newPage": null,
       "promptText": "",
       "min": false
      }
     ],
     "sidebar": [
      "Fix the login bug"
     ]
    },
    "claudeVoice": {
     "rules": {
      "rules": [
       {
        "when": "\\[Tool result: draft_prompt\\]",
        "reply": "Drafted. Want me to send it?"
       },
       {
        "when": "dark mode",
        "reply": "<tool>{\"name\": \"draft_prompt\", \"arguments\": {\"text\": \"Add a dark mode toggle to the settings page.\"}}</tool>"
       }
      ],
      "fallback": "Okay."
     }
    }
   },
   "steps": [
    {
     "do": "act",
     "action": "voice.hotkey"
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 25000,
     "expect": {
      "voice.phase": "listening"
     }
    },
    {
     "do": "act",
     "action": "mic.play",
     "args": {
      "wav": "${audio}/draft.wav"
     }
    },
    {
     "do": "until",
     "probe": "fake",
     "name": "fake-desktop",
     "timeoutMs": 20000,
     "expect": {
      "windows.0.promptText": {
       "$match": "dark mode toggle"
      }
     }
    },
    {
     "do": "fake",
     "name": "fake-desktop",
     "expect": {
      "sends": {
       "$len": 0
      }
     }
    },
    {
     "do": "until",
     "probe": "fake",
     "name": "fake-claude",
     "timeoutMs": 10000,
     "expect": {
      "toolResults": {
       "$contains": "draft_prompt"
      }
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 15000,
     "expect": {
      "voice.playedMs": {
       "$gt": 300
      },
      "voice.draft.text": {
       "$match": "dark mode"
      }
     }
    }
   ]
  },
