  {
   "id": "voice.model-switch",
   "title": "\"Switch to Opus\" changes Claude voice's brain, and the next turn runs on it",
   "needs": [
    "voice"
   ],
   "fixtures": {
    "fakeDesktop": true,
    "claudeVoice": {
     "rules": {
      "rules": [
       {
        "when": "\\[Tool result: change_orbit_setting\\]",
        "reply": "Switched to Opus."
       },
       {
        "when": "opus",
        "reply": "<tool>{\"name\": \"change_orbit_setting\", \"arguments\": {\"setting\": \"voice_model\", \"value\": \"opus\"}}</tool>"
       }
      ],
      "fallback": "Okay."
     }
    }
   },
   "steps": [
    {
     "do": "act",
     "action": "voice.hotkey"
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 25000,
     "expect": {
      "voice.phase": "listening"
     }
    },
    {
     "do": "act",
     "action": "mic.play",
     "args": {
      "wav": "${audio}/model.wav"
     }
    },
    {
     "do": "until",
     "probe": "http",
     "path": "/api/config",
     "timeoutMs": 20000,
     "expect": {
      "body.settings.claudeVoiceModel": "opus"
     }
    },
    {
     "do": "until",
     "probe": "fake",
     "name": "fake-claude",
     "timeoutMs": 15000,
     "expect": {
      "starts": {
       "$some": {
        "model": "opus"
       }
      }
     }
    }
   ]
  },
