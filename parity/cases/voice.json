  {
   "id": "voice.wake-word",
   "title": "\"Hey Orbit\" while Orbit is off starts a call (the wake word setting on)",
   "needs": [
    "voice"
   ],
   "fixtures": {
    "fakeDesktop": true,
    "claudeVoice": {
     "rules": {
      "rules": [],
      "fallback": "Okay."
     },
     "settings": {
      "wakeWord": true
     }
    },
    "key": "xai-parityfakekey0000000000000000000000"
   },
   "steps": [
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 30000,
     "expect": {
      "voice.wakeWord": "listening"
     }
    },
    {
     "do": "state",
     "expect": {
      "voice.phase": "off"
     }
    },
    {
     "do": "act",
     "action": "mic.play",
     "args": {
      "wav": "${audio}/wake.wav"
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 15000,
     "expect": {
      "voice.phase": {
       "$in": [
        "connecting",
        "listening"
       ]
      }
     }
    }
   ],
   "about": "With an xAI key saved: the Electron page only runs the wake word with one (App.tsx), even with Claude voice; Orbit Native doesn't need it there. A known difference, left to decide."
  },
