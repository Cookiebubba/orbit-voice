  {
   "id": "voice.answer-card",
   "title": "Asked what Claude wants, then \"Allow it\": Orbit presses Allow on the card",
   "needs": [
    "voice"
   ],
   "fixtures": {
    "fakeDesktop": {
     "windows": [
      {
       "hwnd": 101,
       "kind": "main",
       "title": "Fix the login bug",
       "newPage": null,
       "promptText": "",
       "min": false,
       "pending": {
        "kind": "permission",
        "title": "Allow Claude to run a command?",
        "detail": "npm test",
        "options": [
         {
          "id": "allow_once",
          "label": "Allow once"
         },
         {
          "id": "allow_always",
          "label": "Always allow"
         },
         {
          "id": "deny",
          "label": "Deny"
         }
        ],
        "key": "parity-card-1"
       }
      }
     ],
     "sidebar": [
      "Fix the login bug"
     ]
    },
    "claudeVoice": {
     "rules": {
      "rules": [
       {
        "when": "\\[Tool result: read_claude_prompt\\]",
        "reply": "It wants to run npm test. Allow it?"
       },
       {
        "when": "\\[Tool result: answer_claude_prompt\\]",
        "reply": "Done."
       },
       {
        "when": "asking",
        "reply": "<tool>{\"name\": \"read_claude_prompt\", \"arguments\": {}}</tool>"
       },
       {
        "when": "allow",
        "reply": "<tool>{\"name\": \"answer_claude_prompt\", \"arguments\": {\"answer\": \"allow\"}}</tool>"
       }
      ],
      "fallback": "Okay."
     }
    }
   },
   "steps": [
    {
     "do": "act",
     "action": "voice.hotkey"
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 25000,
     "expect": {
      "voice.phase": "listening"
     }
    },
    {
     "do": "act",
     "action": "mic.play",
     "args": {
      "wav": "${audio}/asking.wav"
     }
    },
    {
     "do": "until",
     "probe": "fake",
     "name": "fake-claude",
     "timeoutMs": 20000,
     "expect": {
      "toolResults": {
       "$contains": "read_claude_prompt"
      }
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 15000,
     "expect": {
      "voice.phase": "listening",
      "voice.playedMs": {
       "$gt": 300
      }
     }
    },
    {
     "do": "act",
     "action": "mic.play",
     "args": {
      "wav": "${audio}/allow.wav"
     }
    },
    {
     "do": "until",
     "probe": "fake",
     "name": "fake-desktop",
     "timeoutMs": 20000,
     "expect": {
      "answers": {
       "$some": {
        "kind": "permission",
        "choice": "allow_once"
       }
      }
     }
    }
   ]
