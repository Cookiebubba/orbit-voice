{
  "area": "avatar",
  "about": "Picking Qubit up at will (main 0edbf9b, 346a5bc): a quiet or frozen page never makes him unclickable, the mouse mode doesn't flap at his edge, and a fast drag, a hold then drag and a click all reach him, also after he has sat idle a long while. Grok without a key is the engine here, so a click to talk only shows the main page's notice (nothing downloads).",
  "cases": [
    { "id": "avatar.pickup.frozen-page", "title": "His page frozen for 6 s: the cursor on him still takes the mouse, and once it runs a press picks him up",
      "needs": ["avatar", "window"],
      "profile": { "settings": { "avatar": "qubit", "voiceEngine": "grok" } },
      "fixtures": { "standin": { "frame": { "x": 200, "y": 120, "w": 980, "h": 680 } } },
      "steps": [
        { "do": "until", "probe": "state", "timeoutMs": 20000, "expect": { "avatars.0.figure": { "$type": "object" }, "avatars.0.standingOn": { "$in": ["box", "floor"] } } },
        { "do": "act", "action": "cursor.set", "args": { "x": 0, "y": 0 } },
        { "do": "until", "probe": "state", "timeoutMs": 3000, "expect": { "avatars.0.takesMouse": false } },
        { "do": "act", "action": "avatar.eval", "args": { "avatar": "home", "probe": "freeze-page.js" }, "expect": { "ok": true } },
        { "do": "sleep", "ms": 4500 },
        { "do": "state", "expect": { "avatars.0.figure": { "$type": "object" } } },
        { "do": "save", "from": "state", "path": "avatars.0.figure", "as": "f" },
        { "do": "calc", "as": "fx", "expr": "${f.x} + ${f.w} / 2" },
        { "do": "calc", "as": "fy", "expr": "${f.y} + ${f.h} / 2" },
        { "do": "act", "action": "cursor.set", "args": { "x": "${fx}", "y": "${fy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 1000, "expect": { "avatars.0.takesMouse": true } },
        { "do": "sleep", "ms": 2500 },
        { "do": "save", "from": "state", "path": "avatars.0.figure", "as": "g" },
        { "do": "calc", "as": "cx", "expr": "${g.x} + ${g.w} / 2" },
        { "do": "calc", "as": "cy", "expr": "${g.y} + ${g.h} / 2" },
        { "do": "act", "action": "cursor.set", "args": { "x": "${cx}", "y": "${cy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 2000, "expect": { "avatars.0.takesMouse": true } },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "down", "x": "${cx}", "y": "${cy}" } },
        { "do": "calc", "as": "x1", "expr": "${cx} + 12" },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "move", "x": "${x1}", "y": "${cy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 3000, "expect": { "events": { "$some": { "type": "avatar.lift", "data.on": true } } } },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "up", "x": "${x1}", "y": "${cy}" } },
        { "do": "act", "action": "cursor.set", "args": { "x": null, "y": null } }
      ] },
    { "id": "avatar.pickup.no-flap", "title": "The cursor wobbling at his edge: his window's mouse mode doesn't flap",
      "needs": ["avatar", "window"],
      "profile": { "settings": { "avatar": "qubit", "voiceEngine": "grok" } },
      "fixtures": { "standin": { "frame": { "x": 200, "y": 120, "w": 980, "h": 680 } } },
      "steps": [
        { "do": "until", "probe": "state", "timeoutMs": 20000, "expect": { "avatars.0.figure": { "$type": "object" }, "avatars.0.standingOn": { "$in": ["box", "floor"] } } },
        { "do": "save", "from": "state", "path": "avatars.0.figure", "as": "f" },
        { "do": "calc", "as": "inX", "expr": "${f.x} + ${f.w} - 3" },
        { "do": "calc", "as": "outX", "expr": "${f.x} + ${f.w} + 4" },
        { "do": "calc", "as": "cy", "expr": "${f.y} + ${f.h} / 2" },
        { "do": "act", "action": "cursor.set", "args": { "x": 0, "y": 0 } },
        { "do": "until", "probe": "state", "timeoutMs": 3000, "expect": { "avatars.0.takesMouse": false } },
        { "do": "act", "action": "cursor.set", "args": { "x": "${inX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${outX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${inX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${outX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${inX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${outX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${inX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${outX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${inX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${outX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${inX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "act", "action": "cursor.set", "args": { "x": "${outX}", "y": "${cy}" } }, { "do": "sleep", "ms": 40 },
        { "do": "state", "expect": { "avatars.0.takesMouse": true, "events": { "$count": { "where": { "type": "avatar.mode" }, "is": { "$lte": 4 } } } } },
        { "do": "act", "action": "cursor.set", "args": { "x": 0, "y": 0 } },
        { "do": "until", "probe": "state", "timeoutMs": 2000, "expect": { "avatars.0.takesMouse": false } },
        { "do": "act", "action": "cursor.set", "args": { "x": null, "y": null } }
      ] },
    { "id": "avatar.pickup.fast-drag", "title": "A fast press-and-drag (no pause) picks him up",
      "needs": ["avatar", "window"],
      "profile": { "settings": { "avatar": "qubit", "voiceEngine": "grok" } },
      "fixtures": { "standin": { "frame": { "x": 200, "y": 120, "w": 980, "h": 680 } } },
      "steps": [
        { "do": "until", "probe": "state", "timeoutMs": 20000, "expect": { "avatars.0.figure": { "$type": "object" }, "avatars.0.standingOn": { "$in": ["box", "floor"] } } },
        { "do": "save", "from": "state", "path": "avatars.0.figure", "as": "f" },
        { "do": "calc", "as": "cx", "expr": "${f.x} + ${f.w} / 2" },
        { "do": "calc", "as": "cy", "expr": "${f.y} + ${f.h} / 2" },
        { "do": "act", "action": "cursor.set", "args": { "x": "${cx}", "y": "${cy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 3000, "expect": { "avatars.0.takesMouse": true } },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "down", "x": "${cx}", "y": "${cy}" } },
        { "do": "calc", "as": "x1", "expr": "${cx} + 8" },
        { "do": "calc", "as": "y1", "expr": "${cy} - 10" },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "move", "x": "${x1}", "y": "${y1}" } },
        { "do": "calc", "as": "x2", "expr": "${cx} + 30" },
        { "do": "calc", "as": "y2", "expr": "${cy} - 40" },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "move", "x": "${x2}", "y": "${y2}" } },
        { "do": "until", "probe": "state", "timeoutMs": 2000, "expect": { "events": { "$some": { "type": "avatar.lift", "data.on": true } } } },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "up", "x": "${x2}", "y": "${y2}" } },
        { "do": "act", "action": "cursor.set", "args": { "x": null, "y": null } },
        { "do": "until", "probe": "state", "timeoutMs": 12000, "expect": { "avatars.0.lifted": false } }
      ] },
    { "id": "avatar.pickup.hold-then-drag", "title": "Press, hold still, then drag: picked up on the hold",
      "needs": ["avatar", "window"],
      "profile": { "settings": { "avatar": "qubit", "voiceEngine": "grok" } },
      "fixtures": { "standin": { "frame": { "x": 200, "y": 120, "w": 980, "h": 680 } } },
      "steps": [
        { "do": "until", "probe": "state", "timeoutMs": 20000, "expect": { "avatars.0.figure": { "$type": "object" }, "avatars.0.standingOn": { "$in": ["box", "floor"] } } },
        { "do": "save", "from": "state", "path": "avatars.0.figure", "as": "f" },
        { "do": "calc", "as": "cx", "expr": "${f.x} + ${f.w} / 2" },
        { "do": "calc", "as": "cy", "expr": "${f.y} + ${f.h} / 2" },
        { "do": "act", "action": "cursor.set", "args": { "x": "${cx}", "y": "${cy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 3000, "expect": { "avatars.0.takesMouse": true } },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "down", "x": "${cx}", "y": "${cy}" } },
        { "do": "sleep", "ms": 600 },
        { "do": "until", "probe": "state", "timeoutMs": 2000, "expect": { "avatars.0.lifted": true } },
        { "do": "calc", "as": "x1", "expr": "${cx} + 40" },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "move", "x": "${x1}", "y": "${cy}" } },
        { "do": "sleep", "ms": 50 },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "up", "x": "${x1}", "y": "${cy}" } },
        { "do": "act", "action": "cursor.set", "args": { "x": null, "y": null } },
        { "do": "until", "probe": "state", "timeoutMs": 12000, "expect": { "avatars.0.lifted": false, "avatars.0.standingOn": { "$in": ["box", "floor"] } } }
      ] },
    { "id": "avatar.pickup.click-after-idle", "title": "After he has sat idle over 5 minutes, a click on him still lands (talk)",
      "needs": ["avatar", "window", "voice"],
      "profile": { "settings": { "avatar": "qubit", "voiceEngine": "grok" } },
      "fixtures": { "standin": { "frame": { "x": 200, "y": 120, "w": 980, "h": 680 } } },
      "steps": [
        { "do": "until", "probe": "state", "timeoutMs": 20000, "expect": { "avatars.0.figure": { "$type": "object" }, "avatars.0.standingOn": { "$in": ["box", "floor"] } } },
        { "do": "act", "action": "cursor.set", "args": { "x": 0, "y": 0 } },
        { "do": "sleep", "ms": 310000 },
        { "do": "save", "from": "state", "path": "avatars.0.figure", "as": "f" },
        { "do": "calc", "as": "cx", "expr": "${f.x} + ${f.w} / 2" },
        { "do": "calc", "as": "cy", "expr": "${f.y} + ${f.h} / 2" },
        { "do": "act", "action": "cursor.set", "args": { "x": "${cx}", "y": "${cy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 2000, "expect": { "avatars.0.takesMouse": true } },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "down", "x": "${cx}", "y": "${cy}" } },
        { "do": "sleep", "ms": 60 },
        { "do": "act", "action": "pointer", "args": { "avatar": "home", "type": "up", "x": "${cx}", "y": "${cy}" } },
        { "do": "until", "probe": "state", "timeoutMs": 5000, "expect": { "events": { "$some": { "type": "avatar.talk" } } } },
        { "do": "until", "probe": "state", "timeoutMs": 5000, "expect": { "windows.main.notice.kind": "grok-key", "voice.phase": "off" } },
        { "do": "act", "action": "cursor.set", "args": { "x": null, "y": null } }
      ] }
  ]
}
