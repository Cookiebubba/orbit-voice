    "window",
    "voice"
   ],
   "profile": {
    "settings": {
     "avatar": "qubit"
    }
   },
   "fixtures": {
    "standin": {
     "frame": {
      "x": 200,
      "y": 120,
      "w": 980,
      "h": 680
     }
    },
    "fakeDesktop": false,
    "claudeVoice": {
     "rules": {
      "rules": []
     }
    }
   },
   "steps": [
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 20000,
     "expect": {
      "avatars.0.figure": {
       "$type": "object"
      }
     }
    },
    {
     "do": "save",
     "from": "state",
     "path": "avatars.0.figure",
     "as": "f"
    },
    {
     "do": "calc",
     "as": "cx",
     "expr": "${f.x} + ${f.w} / 2"
    },
    {
     "do": "calc",
     "as": "cy",
     "expr": "${f.y} + ${f.h} / 2"
    },
    {
     "do": "act",
     "action": "cursor.set",
     "args": {
      "x": "${cx}",
      "y": "${cy}"
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 3000,
     "expect": {
      "avatars.0.takesMouse": true
     }
    },
    {
     "do": "act",
     "action": "pointer",
     "args": {
      "avatar": "home",
      "type": "down",
      "x": "${cx}",
      "y": "${cy}"
     }
    },
    {
     "do": "sleep",
     "ms": 60
    },
    {
     "do": "act",
     "action": "pointer",
     "args": {
      "avatar": "home",
      "type": "up",
      "x": "${cx}",
      "y": "${cy}"
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 5000,
     "expect": {
      "events": {
       "$some": {
        "type": "avatar.talk"
       }
      }
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 20000,
     "expect": {
      "voice.phase": {
       "$in": [
        "connecting",
        "listening"
       ]
      }
     }
    }
   ]
