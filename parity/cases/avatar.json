{
 "area": "avatar",
 "about": "Qubit (and the pixel buddy) on the stand-in Claude window: where he lives and stands, click-through, click to talk, pick up and throw inside his window, the Wheee, sleep then click, one avatar per place, free-floating without a Claude window, and his art rules. Pointer events go only to the avatar's own window (never the system's cursor).",
 "cases": [
  {
   "id": "avatar.qubit.on-claude-window",
   "title": "Qubit comes up on the Claude window, in a strip along its bottom",
   "needs": [
    "avatar",
    "window"
   ],
   "profile": {
    "settings": {
     "avatar": "qubit"
    }
   },
   "fixtures": {
    "standin": {
     "frame": {
      "x": 200,
      "y": 120,
      "w": 980,
      "h": 680
     }
    }
   },
   "steps": [
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 20000,
     "expect": {
      "avatars": {
       "$some": {
        "id": "home",
        "kind": "qubit",
        "visible": true,
        "host.pid": "${standinPid}"
       }
      }
     }
    },
    {
     "do": "save",
     "from": "state",
     "path": "avatars.0",
     "as": "q"
    },
    {
     "do": "state",
     "expect": {
      "avatars.0.frame": {
       "$inside": "${q.host.frame}"
      },
      "avatars.0.frame.w": {
       "$near": "${q.host.frame.w}",
       "$tol": 2
      }
     }
    },
    {
     "do": "calc",
     "as": "hostBottom",
     "expr": "${q.host.frame.y} + ${q.host.frame.h}"
    },
    {
     "do": "calc",
     "as": "stripBottom",
     "expr": "${q.frame.y} + ${q.frame.h}"
    },
    {
     "do": "calc",
     "as": "gap",
     "expr": "${hostBottom} - ${stripBottom}"
    },
    {
     "do": "check",
     "value": "${gap}",
     "expect": {
      "$gte": -2,
      "$lte": 40
     }
    }
   ]
  },
  {
   "id": "avatar.qubit.stands-on-box",
   "title": "He stands on the prompt box: his feet on its top edge",
   "needs": [
    "avatar",
    "window"
   ],
   "profile": {
    "settings": {
     "avatar": "qubit"
    }
   },
   "fixtures": {
    "standin": {
     "frame": {
      "x": 200,
      "y": 120,
      "w": 980,
      "h": 680
     }
    }
   },
   "steps": [
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 20000,
     "expect": {
      "claude.box": {
       "$type": "object"
      },
      "avatars.0.figure": {
       "$type": "object"
      }
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 15000,
     "expect": {
      "avatars.0.standingOn": "box"
     }
    },
    {
     "do": "save",
     "from": "state",
     "path": "",
     "as": "s"
    },
    {
     "do": "calc",
     "as": "feet",
     "expr": "${s.avatars.0.figure.y} + ${s.avatars.0.figure.h}"
    },
    {
     "do": "state",
     "expect": {
      "avatars.0.figure.x": {
       "$gte": "${s.claude.box.x}"
      }
     }
    },
    {
     "do": "check",
     "value": "${feet}",
     "expect": {
      "$near": "${s.claude.box.y}",
      "$tol": 6
     }
    },
    {
     "do": "state",
     "expect": {
      "claude.box": {
       "$inside": "${s.claude.frame}"
      }
     }
    }
   ]
  },
