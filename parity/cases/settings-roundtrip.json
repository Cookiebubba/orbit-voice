{
 "area": "settings",
 "about": "Generated by parity/tools/gen-settings-cases.mjs from src/config.js DEFAULTS. Every setting the Settings screen shows, both ways, plus the shell-owned ones.",
 "cases": [
  {
   "id": "settings.ui-to-bridge.voice",
   "title": "voice: changed in the app's Settings, the bridge has it",
   "needs": [
    "settings"
   ],
   "steps": [
    {
     "do": "act",
     "action": "settings.ui",
     "args": {
      "key": "voice",
      "value": "ara"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "do": "until",
     "probe": "http",
     "path": "/api/config",
     "timeoutMs": 5000,
     "expect": {
      "body.settings.voice": "ara"
     }
    }
   ]
  },
  {
   "id": "settings.bridge-to-ui.voice",
   "title": "voice: changed through the bridge, the app's Settings shows it live",
   "needs": [
    "settings"
   ],
   "steps": [
    {
     "do": "http",
     "method": "POST",
     "path": "/api/settings",
     "body": {
      "voice": "rex"
     },
     "expect": {
      "status": 200
     }
    },
    {
     "do": "until",
     "probe": "act",
     "action": "settings.read",
     "args": {
      "key": "voice"
     },
     "timeoutMs": 5000,
     "expect": {
      "ok": true,
      "value": "rex"
     }
    }
   ]
  },
