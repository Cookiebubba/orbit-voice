   "title": "anywhereCdp: changed in the app's Settings, the bridge has it",
   "needs": [
    "settings"
   ],
   "steps": [
    {
     "do": "act",
     "action": "settings.ui",
     "args": {
      "key": "anywhereCdp",
      "value": true
     },
     "expect": {
      "ok": true
     }
    },
    {
     "do": "until",
     "probe": "http",
     "path": "/api/config",
     "timeoutMs": 5000,
     "expect": {
      "body.settings.anywhereCdp": true
     }
    }
   ]
  },
