  {
   "id": "settings.hotkey.change",
   "title": "The wake hotkey changed in Settings is registered, shown, and saved in the core's settings",
   "needs": [
    "settings",
    "hotkey"
   ],
   "steps": [
    {
     "do": "act",
     "action": "settings.ui",
     "args": {
      "key": "wakeHotkey",
      "value": "Control+Alt+K"
     },
     "expect": {
      "ok": true
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 3000,
     "expect": {
      "hotkey.accelerator": "Control+Alt+K",
      "hotkey.registered": true,
      "hotkey.label": {
       "$match": "K"
      }
     }
    },
    {
     "do": "until",
     "probe": "http",
     "path": "/api/config",
     "timeoutMs": 3000,
     "expect": {
      "body.settings.wakeHotkey": "Control+Alt+K"
     }
    }
   ]
  },
  {
   "id": "settings.hotkey.rejects-bad",
   "title": "A shortcut that is not valid is refused and the old one stays",
   "needs": [
    "settings",
    "hotkey"
   ],
   "steps": [
    {
     "do": "state",
     "expect": {
      "hotkey.registered": true
     }
    },
    {
     "do": "save",
     "from": "state",
     "path": "hotkey.accelerator",
     "as": "before"
    },
    {
     "do": "act",
     "action": "settings.ui",
     "args": {
      "key": "wakeHotkey",
      "value": "Nonsense+++"
     },
     "expect": {
      "ok": false
     }
    },
    {
     "do": "state",
     "expect": {
      "hotkey.accelerator": "${before}",
      "hotkey.registered": true
     }
    }
   ]
  },
  {
   "id": "settings.login.toggle",
   "title": "Open at login turns on and off (a fake login item in tests)",
   "needs": [
    "settings",
    "login"
   ],
   "env": {
    "ORBIT_FAKE_LOGIN": "1"
   },
   "steps": [
    {
     "do": "state",
     "expect": {
      "login.enabled": false
     }
    },
    {
     "do": "act",
     "action": "settings.ui",
     "args": {
      "key": "openAtLogin",
      "value": true
     },
     "expect": {
      "ok": true
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 3000,
     "expect": {
      "login.enabled": true
     }
    },
    {
     "do": "act",
     "action": "settings.ui",
     "args": {
      "key": "openAtLogin",
      "value": false
     },
     "expect": {
      "ok": true
     }
    },
    {
     "do": "until",
     "probe": "state",
     "timeoutMs": 3000,
     "expect": {
      "login.enabled": false
     }
    }
   ]
  },
