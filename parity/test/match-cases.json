   },
   "pass": true
  },
  {
   "name": "whole-string var keeps type",
   "actual": {
    "w": 300
   },
   "expect": {
    "w": "${f.w}"
   },
   "vars": {
    "f": {
     "w": 300
    }
   },
   "pass": true
  },
  {
   "name": "var inside a string",
   "actual": "frame 300",
   "expect": "frame ${f.w}",
   "vars": {
    "f": {
     "w": 300
    }
   },
   "pass": true
  },
  {
   "name": "object order does not matter",
   "actual": {
    "a": 1,
    "b": 2
   },
   "expect": {
