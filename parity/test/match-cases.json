   },
   "pass": true
  },
  {
   "name": "$count matcher",
   "actual": [
    {
     "v": true
    },
    {
     "v": true
    }
   ],
   "expect": {
    "$count": {
     "where": {
      "v": true
     },
     "is": {
      "$lte": 1
     }
    }
